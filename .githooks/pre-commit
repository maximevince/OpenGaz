#!/usr/bin/env bash
# Pre-commit: catch the things CI's `pnpm lint` job rejects, before they land.
#
# Enabled by `git config core.hooksPath .githooks`, which the package.json
# `prepare` script sets up on every `pnpm install`. Skip once with
# `git commit --no-verify`.
#
# Deliberately fast: formatting + lint on the staged files only. The slow
# gates (pnpm check / test / test:layout / build) stay in CI.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACMR)
[ ${#staged[@]} -eq 0 ] && exit 0

# Files Prettier and ESLint know about. Prettier also owns md/json/css/html.
mapfile -t fmt < <(printf '%s\n' "${staged[@]}" |
  grep -Ei '\.(ts|js|mjs|cjs|svelte|json|md|css|html|yml|yaml)$' || true)
mapfile -t lint < <(printf '%s\n' "${staged[@]}" |
  grep -Ei '\.(ts|js|mjs|cjs|svelte)$' || true)

fail() {
  echo "pre-commit: $1" >&2
  exit 1
}

if [ ${#fmt[@]} -gt 0 ]; then
  # --ignore-unknown so a path Prettier has no parser for is skipped, not fatal.
  pnpm exec prettier --check --ignore-unknown "${fmt[@]}" ||
    fail "Prettier found unformatted files. Run 'pnpm format', then re-stage."
fi

if [ ${#lint[@]} -gt 0 ]; then
  pnpm exec eslint --max-warnings 0 "${lint[@]}" ||
    fail "ESLint failed. Fix the errors above, then re-stage."
fi

# Cheap, and the one guard where a mistake is a licensing problem, not a nit.
pnpm guard:no-original-assets >/dev/null ||
  fail "Original LavaMind assets are staged. They must never be committed."

# Note: checks run against the working tree, so with a partially staged file
# the result reflects the file on disk rather than the staged content.
