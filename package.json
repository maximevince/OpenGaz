{
  "name": "opengaz",
  "private": true,
  "version": "0.4.0",
  "description": "OpenGaz — an open-source homage to Gazillionaire Deluxe, playable in the browser (solo, hot-seat, online).",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "prepare": "git config core.hooksPath .githooks || true",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:layout": "node scripts/layout-audit.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "assets:build": "node scripts/build-assets.mjs",
    "assets:check": "node scripts/build-assets.mjs --check",
    "assets:original": "bash scripts/import-original-assets.sh",
    "guard:no-original-assets": "bash scripts/guard-no-original-assets.sh",
    "guard:no-debug": "bash scripts/guard-no-debug.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.3",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "trystero": "^0.25.3",
    "zzfx": "^1.3.2"
  }
}
